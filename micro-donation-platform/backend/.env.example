# Server
PORT=5000
NODE_ENV=development

# Daily midnight campaign expiry job (IANA timezone; defaults to India)
CAMPAIGN_CRON_TIMEZONE=Asia/Kolkata

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# Razorpay (test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Gmail sender for OTPs, password reset links, and receipts.
# SMTP_PASS is a Google App Password, not the account's normal password.
# Use the same real sender address for SMTP_USER and EMAIL_FROM.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-project-sender@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM=your-project-sender@gmail.com

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
